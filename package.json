{
  "name": "flowcrew",
  "version": "0.12.0",
  "description": "FlowCrew turns a written goal into isolated work with independent verification and an honest report.",
  "main": "dist-rewrite/cli.js",
  "bin": {
    "flowcrew": "dist-rewrite/cli.js"
  },
  "scripts": {
    "clean": "nice -n 19 node -e \"for (const path of ['dist-rewrite', 'dist-monitor']) require('node:fs').rmSync(path,{recursive:true,force:true})\"",
    "build": "nice -n 19 node --import tsx scripts/build.ts",
    "build:clean": "nice -n 19 npm run clean && nice -n 19 npm run build",
    "start": "nice -n 19 node dist-rewrite/cli.js",
    "lint": "nice -n 19 eslint \"rewrite-src/**/*.ts\" \"rewrite-monitor/**/*.ts\" \"integrations/claude/*.mjs\" \"spec/rewrite-hooks-*.test.ts\" \"scripts/package-install.mjs\" \"spec/native/rewrite-integration-engine.test.ts\" \"spec/native/fixtures/public-cli.mjs\"",
    "typecheck": "nice -n 19 tsc --noEmit -p tsconfig.rewrite.json && nice -n 19 tsc --noEmit -p rewrite-monitor/tsconfig.json",
    "test": "nice -n 19 npm run test:portable && nice -n 19 npm run test:native",
    "test:portable": "nice -n 19 vitest run --project portable",
    "test:native": "nice -n 19 vitest run --project native",
    "test:benchmark": "nice -n 19 node --import tsx spec/benchmark/fixtures/rewrite-acceptance/baseline.mts",
    "test:isolation": "nice -n 19 sh scripts/test-isolation.sh",
    "test:package": "nice -n 19 node scripts/package-install.mjs"
  },
  "keywords": [
    "flowcrew",
    "flow-crew",
    "codex",
    "codex-cli",
    "claude-code",
    "ai-agents",
    "agent-orchestration",
    "multi-agent",
    "workflow-runner",
    "workflow-automation",
    "agent-observability",
    "developer-tools",
    "dag",
    "qa-gates",
    "run-memory"
  ],
  "author": "cuibuaa",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist-monitor",
    "config",
    "skills",
    "examples",
    "guide",
    "README.md",
    "LICENSE",
    "dist-rewrite",
    "integrations/claude/flowcrew-session.mjs",
    "rewrite-src/contract/status.mjs",
    "rewrite-src/host/identity.mjs",
    "rewrite-src/contract/lifecycle.mjs",
    "rewrite-src/contract/retirement.mjs"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "dependencies": {
    "yaml": "^2.8.1",
    "zod": "^4.3.6",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "eslint": "^10.1.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.4",
    "esbuild": "^0.28.1"
  },
  "overrides": {
    "vite": "7.3.6",
    "esbuild": "^0.28.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cuibuaa/flow-crew.git"
  },
  "homepage": "https://github.com/cuibuaa/flow-crew#readme",
  "bugs": {
    "url": "https://github.com/cuibuaa/flow-crew/issues"
  }
}
