{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "outDir": "dist-rewrite",
    "rootDir": "rewrite-src",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "rewrite-src/**/*.ts"
  ],
  "exclude": [
    "dist-rewrite",
    "dist-monitor",
    "node_modules"
  ]
}
