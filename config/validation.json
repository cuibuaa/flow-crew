{
  "commands": {
    "build": {
      "command": "npm",
      "args": [
        "run",
        "build"
      ]
    },
    "test": {
      "command": "npm",
      "args": [
        "run",
        "test",
        "--",
        "--reporter=default",
        "--reporter=./config/validation-reporter.ts",
        "--outputFile.json=.cache/validation-tests.json"
      ],
      "report": {
        "format": "vitest-json",
        "path": ".cache/validation-tests.json"
      }
    },
    "lint": {
      "command": "npm",
      "args": [
        "run",
        "lint"
      ]
    }
  }
}
